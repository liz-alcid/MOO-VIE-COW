<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Where to Watch — MOO-vie Cow 🐄</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .picker-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      animation: fade-in 0.2s ease;
    }

    .picker-modal {
      background: var(--white);
      border-radius: 28px;
      padding: 40px 36px;
      max-width: 480px;
      width: 90%;
      box-shadow: 0 24px 80px rgba(0,0,0,0.3);
      border: 3px solid var(--pink-light);
      animation: pop-in 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      text-align: center;
    }

    .picker-cow {
      font-size: 3rem;
      display: block;
      margin-bottom: 8px;
      animation: wiggle 2s ease-in-out infinite;
    }

    .picker-title {
      font-family: var(--font-display);
      font-size: 1.6rem;
      color: var(--pink-dark);
      margin-bottom: 4px;
    }

    .picker-movie {
      font-family: var(--font-display);
      font-size: 2rem;
      color: var(--pink);
      margin-bottom: 6px;
      line-height: 1.1;
    }

    .picker-sub {
      font-size: 0.95rem;
      color: #aaa;
      margin-bottom: 28px;
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }

    .service-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--cream);
      border: 2px solid var(--pink-light);
      border-radius: 16px;
      padding: 14px 18px;
      cursor: pointer;
      font-family: var(--font-body);
      font-size: 1rem;
      font-weight: 700;
      color: #333;
      text-align: left;
      transition: border-color 0.15s, background 0.15s, transform 0.1s, box-shadow 0.1s;
      width: 100%;
    }

    .service-btn:hover {
      border-color: var(--pink);
      background: var(--white);
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(255,105,180,0.2);
    }

    .service-btn:active {
      transform: translateY(0);
    }

    .cancel-link {
      display: inline-block;
      font-size: 0.9rem;
      color: #bbb;
      text-decoration: none;
      margin-top: 4px;
      transition: color 0.15s;
    }

    .cancel-link:hover { color: var(--pink); }

    @keyframes fade-in {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    @keyframes pop-in {
      from { opacity: 0; transform: scale(0.85); }
      to   { opacity: 1; transform: scale(1); }
    }
  </style>
</head>
<body>

  <nav>
    <a class="nav-logo" href="/">🐄 MOO-vie Cow</a>
    <a href="/watchlist">📋 My Watchlist</a>
    <a href="/movies/history">🕓 History</a>
  </nav>

  <!-- background blur -->
  <div class="page" style="filter: blur(2px); pointer-events: none;">
    <div class="hero">
      <h1 class="hero-title">MOO-VIE COW</h1>
      <p class="hero-sub">Watcha in the mood for? 🐄</p>
    </div>
  </div>

  <!-- picker -->
  <div class="picker-overlay">
    <div class="picker-modal">
      <span class="picker-cow">🐄</span>
      <div class="picker-title">Found on multiple services!</div>
      <div class="picker-movie">"<%= movieTitle %>"</div>
      <div class="picker-sub">Which one do you have? Pick your service:</div>

      <div class="service-grid">
        <% availableServices.forEach(service => { %>
          <form action="/movies/pick" method="POST">
            <input type="hidden" name="movieTitle" value="<%= movieTitle %>" />
            <input type="hidden" name="movieId" value="<%= movieId %>" />
            <input type="hidden" name="serviceLabel" value="<%= service.label %>" />
            <input type="hidden" name="serviceUrl" value="<%= service.url %>" />
            <button class="service-btn" type="submit">
<span><%= service.label %></span>
            </button>
          </form>
        <% }); %>
      </div>

      <a class="cancel-link" href="/">← Back to search</a>
    </div>
  </div>

</body>
</html>
